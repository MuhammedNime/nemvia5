{
	"appId": "com.nemvia.app",
	"appName": "NEMVIA",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"*.firebaseapp.com",
			"*.googleapis.com",
			"*.firebasestorage.app",
			"accounts.google.com",
			"meet.jit.si",
			"nemvia-app.onrender.com",
			"*.google.com",
			"*.googleusercontent.com"
		]
	},
	"android": {
		"adjustMarginsForEdgeToEdge": "auto"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"launchAutoHide": true,
			"backgroundColor": "#0f233a",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		},
		"StatusBar": {
			"overlaysWebView": false,
			"style": "DARK",
			"backgroundColor": "#0f233a"
		}
	}
}
