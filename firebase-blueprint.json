        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["author_id", "body", "category", "visibility", "created_at", "updated_at"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on a community post.",
      "type": "object",
      "properties": {
        "post_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "author_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "body": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["post_id", "author_id", "body", "created_at"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Like marker linking user and post.",
