        "submitted_assignments": { "type": "integer", "minimum": 0 },
        "points": { "type": "integer", "minimum": 0 },
        "streak_days": { "type": "integer", "minimum": 0 },
        "classes_count": { "type": "integer", "minimum": 0 },
        "recent_grades": { "type": "array", "maxItems": 20 },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["report_code", "student_id", "student_name", "avg_quiz_score", "completed_quizzes", "submitted_assignments", "points", "streak_days", "classes_count", "recent_grades", "updated_at"]
    },
