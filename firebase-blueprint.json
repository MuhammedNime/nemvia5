      },
      "required": ["host_id", "title", "starts_at", "status", "created_at"]
    },
    "LiveRoomMessage": {
      "title": "LiveRoomMessage",
      "description": "Chat message inside a live classroom session.",
      "type": "object",
      "properties": {
        "room_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sender_id": { "type": "string", "minLength": 1, "maxLength": 128 },
