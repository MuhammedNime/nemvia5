        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "is_teacher": { "type": "boolean" },
        "time": { "type": "string", "maxLength": 32 },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["room_id", "sender_id", "sender_name", "text", "created_at"]
    },
    "LiveRoomPresence": {
      "title": "LiveRoomPresence",
      "description": "Active participant presence inside a live room.",
