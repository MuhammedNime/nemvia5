        "answer": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["caller_id", "caller_name", "callee_id", "callee_name", "participants", "call_type", "status", "offer", "created_at", "updated_at"]
    },
