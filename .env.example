# APP_URL: The public URL where this app is hosted (optional).
APP_URL="MY_APP_URL"

# Remote backend base URL used by the Android APK to call /api/ai/*
VITE_API_BASE_URL="https://ais-pre-wdr7463xhinhkzg4ohx2pf-472107884917.europe-west2.run.app"
